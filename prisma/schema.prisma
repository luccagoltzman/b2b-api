// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Proposta {
  id                      String       @id @default(uuid())
  cliente                 String
  valor                   Float
  status                  String       // 'rascunho' | 'pendente' | 'enviada' | 'em_analise_gerente_compras' | 'em_analise_diretoria' | 'aprovada' | 'rejeitada' | 'cancelada'
  dataCriacao             DateTime     @default(now())
  dataVencimento          DateTime
  descricao               String?      @db.Text
  observacoes             String?      @db.Text
  
  // Campos - Informações do Produto
  produto                 String?
  marca                   String?
  categoria               String?
  unidadeMedida           String?      @default("unidade")
  produtoCodigo           String?
  aliquotaIpi             Float?
  
  // Campos - Valores e Quantidades
  valorUnitario           Float?
  quantidade              Float?
  desconto                Float?
  descontoTipo            String?      @default("percentual") // 'percentual' | 'valor'
  valorFrete              Float?
  
  // Campos - Condições Comerciais
  condicoesPagamento      String?
  prazoEntrega            String?
  tipoPedido              String?      @default("venda") // 'venda' | 'cotacao' | 'orcamento'
  transportadora          String?
  informacoesAdicionais   String?      @db.Text
  
  // Campos - Estratégia de Representação
  estrategiaRepresentacao String?      @db.Text
  publicoAlvo             String?
  diferenciaisCompetitivos String?     @db.Text
  
  // Campos - Informações do Cliente
  clienteCnpj             String?
  clienteEndereco         String?
  clienteNumero            String?
  clienteBairro            String?
  clienteCidade            String?
  clienteCep               String?
  clienteEstado             String?     @db.VarChar(2)
  clienteTelefone          String?
  clienteEmail             String?
  clienteNomeFantasia      String?
  
  // Campos - Dados de Compra (Pós-Venda)
  quantidadeAdquirida     Float?
  valorCompra             Float?
  
  // Campos - Associação com Tabela de Produtos
  tabelaId                String?      // ID da tabela que gerou esta proposta
  geradaAutomaticamente   Boolean      @default(false) // Indica se foi gerada automaticamente
  notaRetornoId           String?      // ID da nota de retorno que gerou esta proposta
  
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  checkpoints             Checkpoint[]
  analisesSaida           AnaliseSaida[]
  tabelaProduto           TabelaProduto? @relation(fields: [tabelaId], references: [id])
  notaRetorno             NotaRetorno?

  @@index([categoria])
  @@index([marca])
  @@index([tipoPedido])
  @@index([tabelaId])
  @@map("propostas")
}

model Visita {
  id          String       @id @default(uuid())
  cliente     String
  data        DateTime
  hora        String
  status      String       // 'agendada' | 'confirmada' | 'em_andamento' | 'realizada' | 'cancelada' | 'reagendada'
  endereco    String?
  observacoes String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  checkpoints Checkpoint[]

  @@map("visitas")
}

model Atividade {
  id          String   @id @default(uuid())
  type        String   // 'visita' | 'proposta' | 'analise'
  description String   @db.Text
  timestamp   DateTime @default(now())
  status      String
  createdAt   DateTime @default(now())

  @@map("atividades")
}

model Checkpoint {
  id          String    @id @default(uuid())
  status      String
  label       String
  descricao   String?   @db.Text
  data        DateTime  @default(now())
  usuario     String?   @default("sistema")
  propostaId  String?
  visitaId    String?
  proposta    Proposta? @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  visita      Visita?   @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([propostaId])
  @@index([visitaId])
  @@index([data])
  @@map("checkpoints")
}

model AnaliseSaida {
  id                String   @id @default(uuid())
  propostaId        String
  proposta          Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  dataAnalise       DateTime @default(now())
  quantidadeVendida Float
  periodoAnalise    String
  statusSaida       String   // 'boa' | 'regular' | 'ruim'
  analise           String   @db.Text
  pontosPositivos   String   @db.Text // JSON array como string
  pontosNegativos    String   @db.Text // JSON array como string
  recomendacoes     String   @db.Text // JSON array como string
  acoesSugeridas    String   @db.Text // JSON array como string
  observacoes       String?  @db.Text
  posicionamento    String?  @db.Text
  concorrencia      String?  @db.Text
  precoAtual        Float?
  usuarioId         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([propostaId])
  @@index([dataAnalise])
  @@map("analises_saida")
}

// Dados de Mercado - Preços de Referência
model PrecoMercado {
  id                String   @id @default(uuid())
  produto           String
  marca             String?
  categoria         String?
  regiao            String?  // Estado ou região (ex: "SP", "Sudeste", "Nacional")
  precoMedio        Float
  precoMinimo       Float?
  precoMaximo       Float?
  unidadeMedida     String?  @default("unidade")
  fonte             String?  // Fonte dos dados (ex: "pesquisa", "fornecedor", "concorrência")
  dataColeta        DateTime @default(now())
  observacoes       String?  @db.Text
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([produto])
  @@index([marca])
  @@index([categoria])
  @@index([regiao])
  @@index([ativo])
  @@map("precos_mercado")
}

// Produtos Mais Vendidos por Região
model ProdutoVendidoRegiao {
  id                String   @id @default(uuid())
  produto           String
  marca             String?
  categoria         String?
  regiao            String   // Estado ou região
  posicaoRanking    Int      // Posição no ranking (1 = mais vendido)
  volumeVendas      Float?   // Volume estimado de vendas
  participacaoMercado Float? // Percentual de participação no mercado
  periodo           String   // Período da análise (ex: "2024-01", "2024-Q1")
  fonte             String?  // Fonte dos dados
  observacoes       String?  @db.Text
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([produto])
  @@index([marca])
  @@index([categoria])
  @@index([regiao])
  @@index([periodo])
  @@index([ativo])
  @@map("produtos_vendidos_regiao")
}

// Produtos Mais Pedidos por Supermercados
model ProdutoPedidoSupermercado {
  id                String   @id @default(uuid())
  produto           String
  marca             String?
  categoria         String?
  tipoSupermercado  String?  // Tipo de rede (ex: "grande", "médio", "pequeno")
  frequenciaPedidos Int      // Frequência de pedidos (1 = mais pedido)
  demandaEstimada  Float?   // Demanda estimada
  sazonalidade      String?  // Sazonalidade (ex: "verão", "inverno", "ano todo")
  periodo           String   // Período da análise
  fonte             String?  // Fonte dos dados
  observacoes       String?  @db.Text
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([produto])
  @@index([marca])
  @@index([categoria])
  @@index([tipoSupermercado])
  @@index([periodo])
  @@index([ativo])
  @@map("produtos_pedidos_supermercado")
}

// Benchmarks do Setor
model BenchmarkSetor {
  id                String   @id @default(uuid())
  categoria         String?  // Categoria de produto
  tipoMetrica       String   // Tipo de métrica (ex: "taxa_conversao", "ticket_medio", "margem_lucro")
  valorBenchmark    Float    // Valor do benchmark
  unidade           String?  // Unidade (ex: "percentual", "reais")
  descricao         String?  @db.Text
  fonte             String?  // Fonte do benchmark
  periodo           String?  // Período de referência
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([categoria])
  @@index([tipoMetrica])
  @@index([ativo])
  @@map("benchmarks_setor")
}

// Tabelas de Produtos - Para envio em massa e geração automática de propostas
model TabelaProduto {
  id                String            @id @default(uuid())
  nome              String
  representanteId   String?           // ID do representante (pode ser null se não houver autenticação)
  status            String            @default("rascunho") // 'rascunho' | 'enviada' | 'aguardando_resposta' | 'proposta_gerada'
  condicoesPagamento String?          @db.Text
  prazoEntrega      String?           @db.Text
  observacoes       String?           @db.Text
  dataCriacao       DateTime          @default(now())
  dataVencimento    DateTime
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  // Relações
  clientes          TabelaCliente[]
  produtos          TabelaProdutoItem[]
  propostas         Proposta[]
  envios            TabelaEnvio[]
  notasRetorno      NotaRetorno[]

  @@index([representanteId])
  @@index([status])
  @@index([dataCriacao])
  @@map("tabelas_produtos")
}

// Clientes associados a uma tabela de produtos
model TabelaCliente {
  id                String            @id @default(uuid())
  tabelaId          String
  clienteNome       String
  clienteEmail      String?           // Para envio por email
  clienteTelefone    String?           // Para envio por WhatsApp
  statusEnvio       String            @default("pendente") // 'pendente' | 'enviada' | 'entregue' | 'lida' | 'respondida'
  dataEnvio         DateTime?
  metodoEnvio       String?           // 'email' | 'whatsapp' | 'manual'
  createdAt         DateTime          @default(now())
  
  tabela            TabelaProduto     @relation(fields: [tabelaId], references: [id], onDelete: Cascade)

  @@index([tabelaId])
  @@map("tabela_clientes")
}

// Produtos dentro de uma tabela de produtos
model TabelaProdutoItem {
  id                String            @id @default(uuid())
  tabelaId          String
  produto           String
  produtoCodigo     String?
  marca             String
  categoria         String?
  unidadeMedida     String
  quantidade        Int               // Quantidade já definida pelo representante
  valorUnitario     Float
  aliquotaIpi       Float?           @default(0)
  desconto           Float?           @default(0) // Desconto interno (não aparece para o cliente)
  descontoTipo      String?          @default("percentual") // 'percentual' | 'valor'
  ordem             Int?              // Ordem de exibição
  createdAt         DateTime          @default(now())
  
  tabela            TabelaProduto     @relation(fields: [tabelaId], references: [id], onDelete: Cascade)

  @@index([tabelaId])
  @@index([produto])
  @@index([marca])
  @@map("tabela_produtos")
}

// Histórico de envios (preparação para Email/WhatsApp)
model TabelaEnvio {
  id                String            @id @default(uuid())
  tabelaId          String
  clienteNome       String
  metodoEnvio       String            // 'email' | 'whatsapp' | 'manual'
  destinatario      String            // email ou telefone
  status            String            @default("pendente") // 'pendente' | 'enviado' | 'entregue' | 'lida' | 'erro'
  arquivoPdfUrl     String?           @db.Text
  arquivoExcelUrl   String?           @db.Text
  mensagemId        String?           // ID da mensagem no WhatsApp/Email (para rastreamento)
  dataEnvio         DateTime?
  dataEntrega       DateTime?
  dataLeitura       DateTime?
  erro              String?           @db.Text // Mensagem de erro se houver
  createdAt         DateTime          @default(now())
  
  tabela            TabelaProduto     @relation(fields: [tabelaId], references: [id], onDelete: Cascade)

  @@index([tabelaId])
  @@index([clienteNome])
  @@index([status])
  @@map("tabela_envios")
}

// Notas de retorno (histórico)
model NotaRetorno {
  id                String            @id @default(uuid())
  tabelaId          String
  clienteNome       String
  propostaId        String?           @unique // Proposta gerada a partir desta nota (unique para relação one-to-one)
  dataGeracao       DateTime          @default(now())
  createdAt         DateTime          @default(now())
  
  tabela            TabelaProduto     @relation(fields: [tabelaId], references: [id], onDelete: Cascade)
  proposta          Proposta?         @relation(fields: [propostaId], references: [id])
  produtos          NotaRetornoProduto[]

  @@index([tabelaId])
  @@index([clienteNome])
  @@map("notas_retorno")
}

// Produtos selecionados na nota de retorno
model NotaRetornoProduto {
  id                String            @id @default(uuid())
  notaRetornoId     String
  produtoId         String            // ID do produto na tabela
  produtoNome       String
  quantidade        Int
  valorUnitario     Float
  valorTotal         Float
  createdAt         DateTime          @default(now())
  
  notaRetorno       NotaRetorno      @relation(fields: [notaRetornoId], references: [id], onDelete: Cascade)

  @@index([notaRetornoId])
  @@index([produtoId])
  @@map("nota_retorno_produtos")
}
