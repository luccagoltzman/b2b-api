// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Proposta {
  id                      String       @id @default(uuid())
  cliente                 String
  valor                   Float
  status                  String       // 'rascunho' | 'pendente' | 'enviada' | 'em_analise_gerente_compras' | 'em_analise_diretoria' | 'aprovada' | 'rejeitada' | 'cancelada'
  dataCriacao             DateTime     @default(now())
  dataVencimento          DateTime
  descricao               String?      @db.Text
  observacoes             String?      @db.Text
  
  // Campos - Informações do Produto
  produto                 String?
  marca                   String?
  categoria               String?
  unidadeMedida           String?      @default("unidade")
  produtoCodigo           String?
  aliquotaIpi             Float?
  
  // Campos - Valores e Quantidades
  valorUnitario           Float?
  quantidade              Float?
  desconto                Float?
  descontoTipo            String?      @default("percentual") // 'percentual' | 'valor'
  valorFrete              Float?
  
  // Campos - Condições Comerciais
  condicoesPagamento      String?
  prazoEntrega            String?
  tipoPedido              String?      @default("venda") // 'venda' | 'cotacao' | 'orcamento'
  transportadora          String?
  informacoesAdicionais   String?      @db.Text
  
  // Campos - Estratégia de Representação
  estrategiaRepresentacao String?      @db.Text
  publicoAlvo             String?
  diferenciaisCompetitivos String?     @db.Text
  
  // Campos - Informações do Cliente
  clienteCnpj             String?
  clienteEndereco         String?
  clienteNumero            String?
  clienteBairro            String?
  clienteCidade            String?
  clienteCep               String?
  clienteEstado             String?     @db.VarChar(2)
  clienteTelefone          String?
  clienteEmail             String?
  clienteNomeFantasia      String?
  
  // Campos - Dados de Compra (Pós-Venda)
  quantidadeAdquirida     Float?
  valorCompra             Float?
  
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  checkpoints             Checkpoint[]
  analisesSaida           AnaliseSaida[]

  @@index([categoria])
  @@index([marca])
  @@index([tipoPedido])
  @@map("propostas")
}

model Visita {
  id          String       @id @default(uuid())
  cliente     String
  data        DateTime
  hora        String
  status      String       // 'agendada' | 'confirmada' | 'em_andamento' | 'realizada' | 'cancelada' | 'reagendada'
  endereco    String?
  observacoes String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  checkpoints Checkpoint[]

  @@map("visitas")
}

model Atividade {
  id          String   @id @default(uuid())
  type        String   // 'visita' | 'proposta' | 'analise'
  description String   @db.Text
  timestamp   DateTime @default(now())
  status      String
  createdAt   DateTime @default(now())

  @@map("atividades")
}

model Checkpoint {
  id          String    @id @default(uuid())
  status      String
  label       String
  descricao   String?   @db.Text
  data        DateTime  @default(now())
  usuario     String?   @default("sistema")
  propostaId  String?
  visitaId    String?
  proposta    Proposta? @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  visita      Visita?   @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([propostaId])
  @@index([visitaId])
  @@index([data])
  @@map("checkpoints")
}

model AnaliseSaida {
  id                String   @id @default(uuid())
  propostaId        String
  proposta          Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  dataAnalise       DateTime @default(now())
  quantidadeVendida Float
  periodoAnalise    String
  statusSaida       String   // 'boa' | 'regular' | 'ruim'
  analise           String   @db.Text
  pontosPositivos   String   @db.Text // JSON array como string
  pontosNegativos    String   @db.Text // JSON array como string
  recomendacoes     String   @db.Text // JSON array como string
  acoesSugeridas    String   @db.Text // JSON array como string
  observacoes       String?  @db.Text
  posicionamento    String?  @db.Text
  concorrencia      String?  @db.Text
  precoAtual        Float?
  usuarioId         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([propostaId])
  @@index([dataAnalise])
  @@map("analises_saida")
}

