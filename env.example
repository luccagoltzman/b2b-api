# Porta do servidor
PORT=5000

# URL do banco de dados MySQL
DATABASE_URL="mysql://usuario:senha@localhost:3306/b2b_db"

# API Key do OpenAI (obrigatória)
OPENAI_API_KEY=sua_chave_api_openai_aqui

# Ambiente
NODE_ENV=development

# CORS Origin (opcional, padrão: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# InfoPrice API (opcional - para integração com monitoramento de preços)
# Obtenha essas credenciais com a InfoPrice
INFOPRICE_USERNAME=seu_usuario_infoprice
INFOPRICE_PASSWORD=sua_senha_infoprice
INFOPRICE_STATIC_TOKEN=seu_token_estatico_infoprice

